# ==============================================================================
# MONITORING STACK - CONFIGURACIÓN DEL ENTORNO
# ==============================================================================
# Copia este archivo a '.env' y ajusta los valores antes de levantar el contenedor:
# cp .env.example .env

# --- Grafana: Credenciales y Seguridad Inicial ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ColocaAquiUnaPasswordSeguraDeAdmin
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=https://grafana.homelab.local

# --- Prometheus: Políticas de Retención de Series Temporales (TSDB) ---
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# --- Rutas de Volúmenes Persistentes en el Host ---
DATA_PATH_PROMETHEUS=/opt/homelab/data/prometheus
DATA_PATH_GRAFANA=/opt/homelab/data/grafana
DATA_PATH_UPTIME_KUMA=/opt/homelab/data/uptime-kuma

# --- Red Docker Compartida con el Ingress Proxy ---
PROXY_NETWORK=proxy-net
