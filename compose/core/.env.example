# ==============================================================================
# NGINX PROXY MANAGER - CONFIGURACIÓN DEL ENTORNO
# ==============================================================================
# Copia este archivo a '.env' y ajusta los valores antes de levantar el contenedor:
# cp .env.example .env

# --- Puertos de Ingress en el Host ---
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# --- Rutas de Volúmenes Persistentes (Rutas en el host) ---
NPM_DATA_PATH=/opt/homelab/data/npm/data
NPM_LETSENCRYPT_PATH=/opt/homelab/data/npm/letsencrypt

# --- Red Docker Externa ---
DOCKER_NETWORK=proxy-net

# --- Credenciales Iniciales por Defecto de NPM (Solo lectura/referencia) ---
# Al ingresar por primera vez en http://<IP>:81, el sistema te obligará a cambiarlas:
# DEFAULT_EMAIL=admin@example.com
# DEFAULT_PASSWORD=changeme
